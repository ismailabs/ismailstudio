{
  "name": "ismailstudio",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "engines": { "node": ">=22.22.0" },
  "scripts": {
    "dev": "astro dev --host 127.0.0.1",
    "check": "astro check",
    "build": "astro build && node scripts/build-headers.mjs",
    "preview": "astro preview --host 127.0.0.1",
    "test": "playwright test",
    "test:redirect": "node --test tests-worker/*.test.mjs",
    "verify": "python tools/validate_handoff.py && npm run check && npm run build && npm run test:redirect && npm test",
    "capture:projects": "node scripts/capture-projects.mjs",
    "package:cloudflare": "node scripts/package-cloudflare.mjs",
    "deploy:worker": "cf deploy --prebuilt --mode production"
  },
  "dependencies": {
    "@fontsource-variable/geist": "5.3.0",
    "@tailwindcss/vite": "4.3.3",
    "astro": "7.4.1",
    "tailwindcss": "4.3.3"
  },
  "devDependencies": {
    "@astrojs/check": "0.9.11",
    "@axe-core/playwright": "4.14.0",
    "@playwright/test": "1.64.1",
    "cf": "1.0.0-beta.19",
    "lighthouse": "13.5.0",
    "sharp": "0.35.5",
    "typescript": "5.9.3"
  }
}
