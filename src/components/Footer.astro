---
import Brand from './Brand.astro';
import { formConfig } from '../lib/form-config';
---
<footer class="site-footer shell"><div class="footer-top"><div><Brand large/><p>Professional websites for small businesses in Malaysia.</p></div><nav aria-label="Footer navigation"><a href="#work">Work</a><a href="#services">Services</a><a href="#process">Process</a><a href="#contact">Contact</a><a href="mailto:contact@ismailstudio.my">Email</a></nav></div><details id="privacy-note" class="privacy-note"><summary>Enquiry privacy details</summary><p>{formConfig.active ? 'Formspree processes your enquiry and sends a notification to contact@ismailstudio.my. Your name, email and the project details you choose to share are used to respond and discuss your requirements. Formspree may retain a submission in its service according to the account settings and privacy policy.' : 'This page does not send enquiry details to a form service. Preparing an enquiry opens your email app; you choose whether to send it. Your email provider and Zoho Mail process messages you send to contact@ismailstudio.my.'} Enquiry correspondence is kept only as needed for your request and any agreed project records. To ask about your enquiry or request deletion, email contact@ismailstudio.my. This website does not use advertising pixels or store form drafts.</p>{formConfig.active && <a class="inline-link" href="https://formspree.io/legal/privacy-policy/" target="_blank" rel="noopener noreferrer">Formspree privacy policy (opens in a new tab)</a>}</details><div class="footer-bottom"><p>© {new Date().getFullYear()} Ismail Studio</p><p>Independent. Based in Malaysia.</p><a href="#top">Back to top ↑</a></div></footer>
