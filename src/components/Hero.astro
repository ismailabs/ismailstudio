---
import Arrow from './Arrow.astro';
---
<section class="hero shell" aria-labelledby="hero-heading">
  <div class="hero-copy">
    <p class="eyebrow hero-eyebrow"><span class="signal" aria-hidden="true"></span> Independent web design & development · Malaysia</p>
    <h1 id="hero-heading" data-reveal>Professional websites for small businesses.</h1>
    <p class="hero-description">I design and build clean, mobile-friendly websites that help businesses explain what they offer and make it easier for customers to get in touch.</p>
    <div class="hero-actions"><a href="#contact" class="button">Get a Website Quote <Arrow diagonal /></a><a href="#work" class="text-link">Explore My Work <Arrow /></a></div>
    <p class="hero-proof">Websites from RM599 <span aria-hidden="true">·</span> Mobile-responsive <span aria-hidden="true">·</span> Basic SEO included</p>
  </div>
  <figure class="hero-art">
    <img src="/assets/hero-editorial.svg" alt="" width="1200" height="1000" fetchpriority="high" />
    <figcaption><span>Clarity, from the first impression.</span><span aria-hidden="true">IS / 01</span></figcaption>
  </figure>
</section>
