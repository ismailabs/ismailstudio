---
import { projects } from '../data/projects';
import { studies } from '../data/studies';
import Arrow from './Arrow.astro';
---
<section id="work" class="work-band" aria-labelledby="work-heading"><div class="shell section-space">
  <div class="section-intro work-intro"><div><p class="eyebrow">Selected work / Four explorations</p><h2 id="work-heading">IDEAS GIVEN<br/><em>DIGITAL FORM.</em></h2></div><p>Four concept projects. Four different approaches to design and development.<br/><strong>Self-initiated concepts, not commissioned client work.</strong></p></div>
  <div class="project-grid">{projects.map((project, i) => <article class={`project project-${project.slug}`}>
    <a class="project-preview" href={`/work/${project.slug}/`} data-case={project.slug} aria-label={`Concept Project: read the ${project.name} study`}>
      <img src={`/assets/projects/${project.slug}-800.webp`} srcset={[400,640,800,1200].map(w => `/assets/projects/${project.slug}-${w}.webp ${w}w`).join(', ')} sizes="(max-width: 700px) 100vw, (max-width: 1100px) 50vw, 720px" alt={project.alt} width="1200" height="825" loading="lazy"/>
      <span class="concept-label">Concept Project</span><span class="project-open" aria-hidden="true"><Arrow diagonal/></span>
    </a><div class="project-caption"><div><h3><a href={`/work/${project.slug}/`} data-case={project.slug}>{project.name}</a></h3><p>{project.category}</p></div><a class="project-live" href={project.url} target="_blank" rel="noopener noreferrer" aria-label={`Explore ${project.name} live concept (opens in a new tab)`}>Live concept <Arrow diagonal/></a></div>
    <p class="project-description">{project.description}</p>
    <dialog class="case-dialog" id={`case-${project.slug}`} aria-labelledby={`case-heading-${project.slug}`}>
      <div class="case-toolbar"><span>ISMAIL STUDIO / PROJECT STUDY</span><button type="button" class="case-close" aria-label={`Close ${project.name} study`} autofocus>×</button></div>
      <div class="case-layout"><div class="case-image"><p class="concept-label">Concept Project</p><img src={`/assets/projects/${project.slug}-1200.webp`} alt={project.alt} width="1200" height="825" loading="lazy"/><p>{project.category}<br/>Authentic preview of the linked concept.</p></div><div class="case-copy"><p class="eyebrow">Project study / {String(i+1).padStart(2,'0')}</p><h2 id={`case-heading-${project.slug}`}>{project.name}</h2><p>{project.description}</p><dl>{studies[project.slug].map(item => <div><dt>{item.title}</dt><dd>{item.text}</dd></div>)}</dl><a class="button button-dark" href={project.url} target="_blank" rel="noopener noreferrer">Explore the live concept <Arrow diagonal/><span class="sr-only"> (opens in a new tab)</span></a><a class="case-permalink" href={`/work/${project.slug}/`}>Open this study as a page</a></div></div>
    </dialog>
  </article>)}</div>
</div></section>
