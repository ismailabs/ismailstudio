---
import Icon from './Icon.astro';
const steps = [
  { name: 'Discover', description: 'Discuss your business, your visitors and what they need to find or do.', icon: 'messages' },
  { name: 'Define', description: 'Agree the pages, content responsibilities, price and estimated schedule in writing.', icon: 'clipboard' },
  { name: 'Design & build', description: 'Bring the content, visual direction and responsive code together.', icon: 'code' },
  { name: 'Review', description: 'Refine the details within your agreed revision rounds.', icon: 'eye' },
  { name: 'Launch', description: 'Check the website, confirm approval and arrange deployment with the agreed files and access.', icon: 'rocket' },
] as const;
---
<section id="process" class="process shell section-space" aria-labelledby="process-heading"><p class="eyebrow">The approach</p><h2 id="process-heading">A clear way<br/><span class="text-muted">from idea to website.</span></h2><ol class="process-track">{steps.map(step => <li data-process><Icon name={step.icon}/><h3>{step.name}</h3><p>{step.description}</p></li>)}</ol></section>
