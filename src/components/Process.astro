---
const steps = [
  ['Discuss', 'Your business, the problem and what people need to find.'],
  ['Define', 'Scope, content, responsibilities and a clear quote.'],
  ['Build', 'Responsive pages with a considered visual direction.'],
  ['Review', 'Your feedback, refined within the agreed revision rounds.'],
  ['Launch', 'Final checks, deployment and a practical handover.'],
];
---
<section id="process" class="process shell section-space" aria-labelledby="process-heading"><p class="eyebrow">The approach</p><h2 id="process-heading">FROM THE PROBLEM<br/><em>FORWARD.</em></h2><ol class="process-track">{steps.map(([name,description],i) => <li data-process><span class="step-number">0{i+1}</span><h3>{name}</h3><p>{description}</p></li>)}</ol></section>
