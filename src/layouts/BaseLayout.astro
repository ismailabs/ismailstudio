---
import '../styles/global.css';
import geistLatin from '@fontsource-variable/geist/files/geist-latin-wght-normal.woff2?url';
const title = 'Ismail Studio | Web Design for Small Businesses in Malaysia';
const description = "Professional, mobile-friendly websites for Malaysian small businesses. Explore Ismail Studio's concept projects and packages starting from RM599.";
const canonical = 'https://www.ismailstudio.my/';
const schema = { '@context': 'https://schema.org', '@type': 'WebSite', name: 'Ismail Studio', url: canonical, description, inLanguage: 'en-MY' };
---
<!doctype html>
<html lang="en-MY">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <meta name="robots" content="index, follow, max-image-preview:large" />
    <meta name="theme-color" content="#F6F5F1" />
    <link rel="preload" href={geistLatin} as="font" type="font/woff2" crossorigin />
    <link rel="canonical" href={canonical} />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="icon" sizes="32x32" href="/favicon.ico" />
    <link rel="apple-touch-icon" sizes="180x180" href="/apple-touch-icon.png" />
    <meta property="og:type" content="website" />
    <meta property="og:locale" content="en_MY" />
    <meta property="og:site_name" content="Ismail Studio" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={`${canonical}og-image.png`} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content="Ismail Studio — professional websites for small businesses in Malaysia" />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={`${canonical}og-image.png`} />
    <script type="application/ld+json" set:html={JSON.stringify(schema)} />
  </head>
  <body id="top">
    <a class="skip-link" href="#main">Skip to main content</a>
    <slot />
    <script src="../scripts/site.ts"></script>
  </body>
</html>
